--- a/include/linux/compiler.h
+++ b/include/linux/compiler.h
@@ -278,9 +278,11 @@
 })
 
 #define WRITE_ONCE(x, val)				\
-do {							\
-	*(volatile typeof(x) *)&(x) = (val);		\
-} while (0)
+({							\
