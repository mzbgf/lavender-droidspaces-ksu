Subject: [PATCH] Droidspaces: restore prefixed cgroup file names on noprefix roots
Generated-against: b2ee0c8f4cd75fbb2097b9bcd8dc3306166f241c (pix106/android_kernel_xiaomi_sdm660_southwest-ng)

这一版补丁是由本仓库脚本从上述 commit 的原始文件精确生成的，
上下文与空白字符与被 patch 的树完全一致。

---
--- a/kernel/cgroup/cgroup.c
+++ b/kernel/cgroup/cgroup.c
@@ -3951,6 +3951,18 @@
 		spin_lock_irq(&cgroup_file_kn_lock);
 		cfile->kn = kn;
 		spin_unlock_irq(&cgroup_file_kn_lock);
+	}
+
+	/*
+	 * Android mounts several legacy cgroup controllers with the "noprefix"
+	 * option, so their files lose the subsystem prefix (e.g. "usage" instead
+	 * of "cpuacct.usage").  Droidspaces and LXC probe the canonical prefixed
+	 * names as well, so keep a prefixed alias link on such roots.
+	 */
+	if (cft->ss && (cgrp->root->flags & CGRP_ROOT_NOPREFIX) &&
+	    !(cft->flags & CFTYPE_NO_PREFIX)) {
+		snprintf(name, CGROUP_FILE_NAME_MAX, "%s.%s", cft->ss->name, cft->name);
+		kernfs_create_link(cgrp->kn, name, kn);
 	}
 
 	return 0;
