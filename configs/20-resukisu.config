# ============================================================
# 20-resukisu.config — reSukiSU (ReSukiSU/ReSukiSU) 内核侧配置
# 版本: v4.2.0-rc2 (commit 3576e6a, 2026-09-14)
# 目标内核: Linux 4.19.325 非 GKI -> 只能走 manual hook
#
# 依据: resukisu.org/guide/manual-integrate.html 与 v4.2.0-rc2 的 kernel/Kconfig
#       （该 Kconfig 里 "KernelSU Hooking Method" 是个 choice，默认项是 Tracepoint，
#        而 Tracepoint hook 仅支持 GKI2/5.10+，所以必须显式选 Manual Hook）
#
# 注意: 注释里不要写出符号名的完整前缀形式（参见 00-rom-align.config 顶部说明），
#       否则合并时会删掉基座 defconfig 里的同名项。
# ============================================================

CONFIG_KSU=y

# manual hook: Kconfig 里注明 "Support for kernel 3.4+", 是 4.19 唯一可用路径。
# 不设该项时 choice 会落到默认的 Tracepoint 分支, 在 4.19 上必然编译失败。
CONFIG_KSU_MANUAL_HOOK=y

# 4.19 < 6.8, 这三处 hook 可用 LSM/handler 自动挂, 无需手改源码
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y

# ------------------------------------------------------------
# 明确不使用 SUSFS。
# 该选项与 MANUAL_HOOK 同属一个 choice（互斥），这里额外写出显式关闭行，
# 以防上游把它移出 choice 或改成默认开启。
# 校验: scripts/check-configs.sh 会断言它没有被启用，且构建日志里不得出现
#       susfs 的编译。
# ------------------------------------------------------------
# CONFIG_KSU_SUSFS is not set

# ------------------------------------------------------------
# 显式关闭 kprobes：上游 non-GKI 文档建议使用 manual hook 时关闭它，
# 避免误触 KSU safe mode；本树基座 defconfig 本来也是关闭的，这里钉住。
# 若将来发现某个必需功能依赖 kprobes，再打开这里并同步改 check-configs.sh。
# ------------------------------------------------------------
# CONFIG_KPROBES is not set
