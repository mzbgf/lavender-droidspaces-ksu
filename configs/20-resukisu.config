# ============================================================
# 20-resukisu.config — reSukiSU (ReSukiSU/ReSukiSU) 内核侧配置
# 版本: v4.2.0-rc2 (commit 3576e6a, 2026-09-14)
# 目标内核: Linux 4.19.325 非 GKI -> 只能走 manual hook
#
# 依据: resukisu.org/guide/manual-integrate.html + v4.2.0-rc2 的 kernel/Kconfig
#       (Kconfig 中 choice "KernelSU Hooking Method" 的默认项是 Tracepoint,
#        而 Tracepoint hook 仅支持 GKI2/5.10+, 因此必须显式选 Manual Hook)
# ============================================================

CONFIG_KSU=y

# manual hook: Kconfig 里 "Support for kernel 3.4+", 4.19 唯一可用路径
# (未设该项时 choice 会落到默认的 KSU_TRACEPOINT_HOOK, 在 4.19 上必然编译/运行失败)
CONFIG_KSU_MANUAL_HOOK=y

# 4.19 < 6.8, 这三处 hook 可以用 LSM/handler 自动挂, 无需手改源码
CONFIG_KSU_MANUAL_HOOK_AUTO_SETUID_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INITRC_HOOK=y
CONFIG_KSU_MANUAL_HOOK_AUTO_INPUT_HOOK=y

# ------------------------------------------------------------
# 明确不使用 SUSFS。
# Kconfig 中的 KSU_SUSFS 与 KSU_MANUAL_HOOK 同属一个 choice, 二者互斥;
# 这里额外写出 "is not set" 以防上游把 KSU_SUSFS 移出 choice 或改成默认 y。
# ------------------------------------------------------------
# CONFIG_KSU_SUSFS is not set

# ------------------------------------------------------------
# 关于 CONFIG_KPROBES:
# 上游非 GKI 文档建议使用 manual hook 时关闭 kprobes（避免误触 KSU safe mode）。
# 但本树 defconfig 默认值未开启 kprobes 时无需处理；若合并后 KPROBES=y,
# 且首次开机进入 KSU safe mode, 再打开下面这行重新构建。
# ------------------------------------------------------------
# CONFIG_KPROBES is not set
