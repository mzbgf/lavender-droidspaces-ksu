# ============================================================
# 30-boot-compat.config — 开机关键项「钉住」
#
# 本仓库的基线就是目标 ROM 自己用的内核源码线，所以下面这些项在
# vendor/xiaomi/sdm660_defconfig 里本来就是对的。这里显式再写一遍，
# 目的是：一旦上游把其中某项翻转，我们的构建会立刻体现出来并被
# scripts/check-configs.sh 抓到，而不是等刷机后卡 logo 才发现。
#
# 这些结论都来自同 SoC（SDM660）机型上真机踩过的坑：
#
#   RD_LZ4
#     机型设备树用 BOARD_RAMDISK_USE_LZ4 := true，ROM 的 boot ramdisk 是 LZ4
#     压缩的。内核缺这个解压器就解不开 initramfs → 卡开机 logo。
#
#   PSI
#     我们按 Droidspaces 要求打开了 MEMCG；A16 的 lmkd 在没有 PSI 时会回退到
#     cgroup v1 的 vmpressure 全局监控并失败，刷
#     "Failed to connect to lowmemorykiller" → 开机极慢甚至卡死。
#
#   ANDROID_VENDOR_HOOKS
#     本树 fs/open.c 无条件调用 trace_android_vh_check_file_open()，该 tracepoint
#     定义在 drivers/android/vendor_hooks.o 并由本符号 gating；关掉会在 vmlinux
#     链接阶段报 undefined reference。
#
#   MODULES = 关 / KPROBES = 关
#     与 ROM stock 内核保持一致：
#     - MODULES 关意味着驱动全部内建，不存在 vendor 侧 .ko 与我们的内核版本串
#       不匹配的问题；
#     - KPROBES 关正好符合 reSukiSU manual hook 的建议（避免误触 KSU safe mode）。
#
# 注意: 注释里不要写出符号名的完整前缀形式（参见 00-rom-align.config 顶部说明）。
# ============================================================

CONFIG_RD_LZ4=y
CONFIG_PSI=y
CONFIG_ANDROID_VENDOR_HOOKS=y

# CONFIG_MODULES is not set
# CONFIG_KPROBES is not set

# ------------------------------------------------------------
# 诊断（diag/no-pm-devfreq 分支）：panic 栈显示崩点在 mmc devfreq 调频路径
# （mmc_clk_update_freq 用栈上的 completion，中断里的 complete() 在其超时返回后
#  才执行 → 唤醒失效栈地址 → try_to_wake_up 里 Oops）。
# 本分支直接关掉 PM_DEVFREQ，用来确认是不是这条路径。
# ------------------------------------------------------------
# CONFIG_PM_DEVFREQ is not set
