# ============================================================
# 30-boot-compat.config — 开机关键项「钉住」
#
# 本仓库的基线就是目标 ROM 自己用的内核源码线，所以下面这些项在
# vendor/xiaomi/sdm660_defconfig 里**本来就是对的**。这里显式再写一遍，
# 目的是：一旦上游改动把它们翻转（例如某次更新把 RD_LZ4 关掉、
# 或者把 MODULES 打开），我们的构建会立刻体现出来并被
# scripts/check-configs.sh 抓到，而不是等到刷机后卡 logo 才发现。
#
# 这些结论来自同 SoC（SDM660）机型上真机踩过的坑，逐条给出原因：
#
#   CONFIG_RD_LZ4=y
#     机型设备树用 BOARD_RAMDISK_USE_LZ4 := true，ROM 的 boot ramdisk 是
#     LZ4 压缩的。内核缺这个解压器就解不开 initramfs → 卡开机 logo。
#
#   CONFIG_PSI=y
#     我们按 Droidspaces 要求打开了 MEMCG；A16 的 lmkd 在无 PSI 时回退到
#     cgroup v1 vmpressure 全局监控，会失败并刷
#     "Failed to connect to lowmemorykiller" → 开机极慢/卡死。
#
#   CONFIG_ANDROID_VENDOR_HOOKS=y
#     本树 fs/open.c 无条件调用 trace_android_vh_check_file_open()，该
#     tracepoint 定义在 drivers/android/vendor_hooks.o 里并由本符号 gating；
#     关掉会在 vmlinux 链接阶段报 undefined reference。
#
#   # CONFIG_MODULES is not set
#   # CONFIG_KPROBES is not set
#     与 ROM stock 内核保持一致：
#     - MODULES=n 意味着驱动全部内建，不存在 vendor 侧 .ko 与我们的内核
#       版本串不匹配的问题；
#     - KPROBES=n 正好符合 reSukiSU manual hook 的建议（避免误触 KSU safe mode）。
# ============================================================

CONFIG_RD_LZ4=y
CONFIG_PSI=y
CONFIG_ANDROID_VENDOR_HOOKS=y

# CONFIG_MODULES is not set
# CONFIG_KPROBES is not set
