# ============================================================
# 30-boot-compat.config — 开机关键项「钉住」
#
# 本仓库的基线就是本机实测能开机的那条内核源码线（San-Kernel），所以下面这些项在
# arch/arm64/configs/vendor/lavender-perf_defconfig 里本来就是对的。这里显式再写一遍，
# 目的是：一旦上游把其中某项翻转，我们的构建会立刻体现出来并被
# scripts/check-configs.sh 抓到，而不是等刷机后卡 logo 才发现。
#
# 这些结论都来自同 SoC（SDM660）机型上真机踩过的坑：
#
#   RD_LZ4
#     机型设备树用 BOARD_RAMDISK_USE_LZ4 := true，ROM 的 boot ramdisk 是 LZ4
#     压缩的。内核缺这个解压器就解不开 initramfs → 卡开机 logo。
#
#   PSI
#     我们按 Droidspaces 要求打开了 MEMCG；A16 的 lmkd 在没有 PSI 时会回退到
#     cgroup v1 的 vmpressure 全局监控并失败，刷
#     "Failed to connect to lowmemorykiller" → 开机极慢甚至卡死。
#
#   ANDROID_VENDOR_HOOKS
#     本树 fs/open.c 无条件调用 trace_android_vh_check_file_open()，该 tracepoint
#     定义在 drivers/android/vendor_hooks.o 并由本符号 gating；关掉会在 vmlinux
#     链接阶段报 undefined reference。
#
#   MODULES = 关 / KPROBES = 关
#     与 ROM stock 内核保持一致：
#     - MODULES 关意味着驱动全部内建，不存在 vendor 侧 .ko 与我们的内核版本串
#       不匹配的问题；
#     - KPROBES 关正好符合 reSukiSU manual hook 的建议（避免误触 KSU safe mode）。
#
#   panic 行为
#     基座 defconfig 里 PANIC_ON_OOPS 是开的、PANIC_TIMEOUT 是 -1，表现为
#     「任何 oops 立刻 panic，且永不自动重启（屏幕只剩背光，只能长按电源键）」。
#     这里改成与 ROM 原内核（San-Kernel 发布版）一致的行为：
#     oops 只杀掉出错的进程、panic 之后 5 秒自动重启（便于自恢复，日志仍在
#     recovery 的 /sys/fs/pstore/console-ramoops-0 里）。
#
#   栈变量初始化（INIT_STACK 三选一）
#     这一项的默认值由编译器能力探测（CC_HAS_AUTO_VAR_INIT_ZERO）决定：
#     探测通过就默认「zero-init everything」，否则退回「no initialization」。
#     配方此前没钉它，于是 CI 与本地静默分叉：CI 落到 NONE、本地落到 ZERO。
#     2026-09-16 真机实测：CI 那份（NONE）在开机约 54 秒时于回收路径
#     buffer_check_dirty_writeback 空指针 oops，kswapd 被杀、整机随后僵死；
#     同一棵树同一份配置、只把它改成 ZERO 的本地构建则没有该问题。
#     这里显式钉在 ZERO（Kconfig 里称其为 strongest and safest），
#     并由 check-configs.sh / verify-artifacts.sh 两道断言守住，禁止再漂移。
#
#   LTO 三选一（钉在 NONE）
#     同一次事故的第二处：基座 defconfig 写的是 LTO_CLANG_THIN=y，但它的可见性
#     同样取决于编译器能力探测——探测失败时符号被隐藏，三选一静默退回 LTO_NONE。
#     真机验证过的那份产物就是 LTO_NONE（探测失败导致），所以这里明确钉在 NONE，
#     保持与已验证基线一致。想启用 ThinLTO 的话那是一次独立的代码生成变更，
#     必须单独做 A/B 真机验证后再改（改这里 + 一起改断言）。
#
# 注意: 注释里不要写出符号名的完整前缀形式（参见 00-rom-align.config 顶部说明）。
# ============================================================

CONFIG_RD_LZ4=y
CONFIG_PSI=y
CONFIG_ANDROID_VENDOR_HOOKS=y
CONFIG_PANIC_TIMEOUT=5

# CONFIG_MODULES is not set
# CONFIG_KPROBES is not set
# CONFIG_PANIC_ON_OOPS is not set

CONFIG_INIT_STACK_ALL_ZERO=y
# CONFIG_INIT_STACK_NONE is not set

CONFIG_LTO_NONE=y
# CONFIG_LTO_CLANG_THIN is not set
# CONFIG_LTO_CLANG_FULL is not set
