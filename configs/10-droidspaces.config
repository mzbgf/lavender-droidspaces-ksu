# ============================================================
# 10-droidspaces.config — Droidspaces (ravindu644/Droidspaces-OSS) 非 GKI 内核配置
# 目标内核: Linux 4.19.325 (sdm660 / lavender)
#
# 来源: Droidspaces-OSS Documentation/Kernel-Configuration.md
#       ("Configuring Non-GKI Kernels" 的步骤 1 + 步骤 2 官方清单)
# 4.19 符号名已逐条对照本树 Kconfig 校正, 校正点见行内注释。
#
# 合并顺序: vendor/xiaomi/sdm660_defconfig → vendor/xiaomi/lavender.config
#           → 00-rom-align.config → 本文件 → 20-resukisu.config → 30-boot-compat.config
# ============================================================

# ---------------- 步骤 1: 官方必选 ----------------

# IPC 机制
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# 核心命名空间 (sdm660_defconfig 显式关闭了 PID_NS/UTS_NS, 此处覆盖)
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# Seccomp
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# cgroup v1 (4.19 无 cgroup v2, 官方对 4.4-4.19 只要求 v1)
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
# FAIR_GROUP_SCHED：官方清单要求开启，但本树基座 defconfig 是显式关闭的（WALT 内核）。
# 实测开启后内核在启动约 8s、mmc devfreq 调频路径上 panic
# （Oops 在 try_to_wake_up，由中断里的 complete() 触发），故这里显式关闭。
# scripts/check-configs.sh 的 CORE 列表已在诊断分支上同步移除该项。
# CONFIG_FAIR_GROUP_SCHED is not set
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# 设备文件系统 / Overlay / tmpfs
CONFIG_DEVTMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# 固件加载
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
# 注: 4.19 部分树无 FW_LOADER_COMPRESS 符号; 若本树存在则由 check-configs.sh 提示

# ---------------- 步骤 1: 网络隔离 (NAT / 无网络模式) ----------------
CONFIG_NET_NS=y
CONFIG_VETH=y
# IPv6 必须内置: 4.19 中 BRIDGE / NETFILTER_XT_TARGET_TCPMSS / HASHLIMIT 依赖
# "IPV6 || IPV6=n", 若 IPV6=m 会被钳制成 =m, 违反官方 "必须 =y" 的要求
CONFIG_IPV6=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
# 注: 4.19 无 NETFILTER_XT_TARGET_MASQUERADE, 由 IP_NF_TARGET_MASQUERADE 承担
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
# 注: 4.19 的符号名是 NF_CT_NETLINK (官方文档写的 NF_CONNTRACK_NETLINK 是旧名)
CONFIG_NF_CT_NETLINK=y
# 注: 4.19 无 NF_NAT_REDIRECT 提示项, 由该 REDIRECT 目标 select 置位
CONFIG_NETFILTER_XT_TARGET_REDIRECT=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_NF_NAT_IPV4=y
CONFIG_IP_NF_NAT=y
CONFIG_IP6_NF_IPTABLES=y

# 注: 官方清单要求关闭 ANDROID_PARANOID_NETWORK，但本树没有这个符号
#     （已在 net/Kconfig、security/Kconfig 及全树搜索确认），故不写入；
#     若换到别的 4.4/4.14 树，需要补上 CONFIG_<该符号>=n 这一行，
#     否则容器内无法联网。

# 修 Docker "unsafe procfs" 报错
CONFIG_USER_NS=y

# ---------------- 步骤 2: 容器内 UFW / Fail2ban 支持 ----------------
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_HL=y
# 注: 4.19 无 NETFILTER_XT_TARGET_REJECT, 由 IP_NF_TARGET_REJECT 承担
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_HASHLIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_NETFILTER_NETLINK_QUEUE=y
CONFIG_NETFILTER_NETLINK_LOG=y
CONFIG_NETFILTER_XT_TARGET_NFLOG=y

# ---------------- 运行期可选功能 (官方 Recommended) ----------------
# rootfs.img 方案需要 loop + ext4; 容器内 ext4 镜像挂载需要 kvm 之外的 loop
CONFIG_BLK_DEV_LOOP=y
CONFIG_EXT4_FS=y
