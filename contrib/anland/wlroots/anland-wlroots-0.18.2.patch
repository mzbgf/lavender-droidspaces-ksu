diff -ruN --ex wlroots-clean/backend/anland/output.c wlroots-0.18.2/backend/anland/output.c
--- wlroots-clean/backend/anland/output.c	1970-01-01 08:00:00
+++ wlroots-0.18.2/backend/anland/output.c	2026-09-23 14:10:58
@@ -0,0 +1,550 @@
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include <wlr/backend/anland.h>
+#include <wlr/interfaces/wlr_buffer.h>
+#include <wlr/interfaces/wlr_output.h>
+#include <wlr/render/dmabuf.h>
+#include <wlr/render/pass.h>
+#include <wlr/render/wlr_renderer.h>
+#include <wlr/render/wlr_texture.h>
+#include <wlr/types/wlr_output_layer.h>
+#include <wlr/util/log.h>
+
+#include "anland.h"
+#include "display_producer.h"
+#include "protocol.h"
+#include "types/wlr_output.h"
+
+static const uint32_t SUPPORTED_OUTPUT_STATE =
+	WLR_OUTPUT_STATE_BACKEND_OPTIONAL |
+	WLR_OUTPUT_STATE_BUFFER |
+	WLR_OUTPUT_STATE_ENABLED |
+	WLR_OUTPUT_STATE_MODE;
+
+/*
+ * buf_info.format 1 is Android PIXEL_FORMAT_RGBA_8888 (R8G8B8A8 in memory),
+ * which is DRM_FORMAT_ABGR8888. Everything else is treated as XRGB8888, the
+ * same mapping weston's anland backend uses.
+ */
+static uint32_t protocol_format_to_drm(uint32_t fmt) {
+	switch (fmt) {
+	case 1:
+		return DRM_FORMAT_ABGR8888;
+	default:
+		return DRM_FORMAT_XRGB8888;
+	}
+}
+
+static void buffer_destroy(struct wlr_buffer *wlr_buffer) {
+	struct wlr_anland_buffer *buffer =
+		wl_container_of(wlr_buffer, buffer, base);
+
+	wlr_dmabuf_attributes_finish(&buffer->dmabuf);
+	free(buffer);
+}
+
+static bool buffer_get_dmabuf(struct wlr_buffer *wlr_buffer,
+		struct wlr_dmabuf_attributes *attribs) {
+	struct wlr_anland_buffer *buffer =
+		wl_container_of(wlr_buffer, buffer, base);
+	*attribs = buffer->dmabuf;
+	return true;
+}
+
+/*
+ * CPU access for the copy fallback (and for the pixman renderer). The dma-buf
+ * is mapped once on first use and kept for the buffer's lifetime: the consumer
+ * set is small and re-imported wholesale whenever the consumer reconnects.
+ */
+static bool buffer_begin_data_ptr_access(struct wlr_buffer *wlr_buffer,
+		uint32_t flags, void **data, uint32_t *format, size_t *stride) {
+	struct wlr_anland_buffer *buffer =
+		wl_container_of(wlr_buffer, buffer, base);
+
+	if (!(flags & WLR_BUFFER_DATA_PTR_ACCESS_WRITE)) {
+		// We only ever write into consumer buffers.
+		return false;
+	}
+
+	if (buffer->map == NULL) {
+		off_t size = lseek(buffer->dmabuf.fd[0], 0, SEEK_END);
+		if (size < 0) {
+			// Not seekable (typical for dma-buf): fall back to offset + a
+			// full-frame footprint.
+			size = buffer->dmabuf.offset[0] +
+				(off_t)buffer->dmabuf.stride[0] * buffer->base.height;
+		}
+		if (lseek(buffer->dmabuf.fd[0], 0, SEEK_SET) < 0) {
+			// Non-seekable fd: mmap just the footprint we know about.
+			size = buffer->dmabuf.offset[0] +
+				(off_t)buffer->dmabuf.stride[0] * buffer->base.height;
+		}
+		buffer->map = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED,
+			buffer->dmabuf.fd[0], 0);
+		if (buffer->map == MAP_FAILED) {
+			buffer->map = NULL;
+			wlr_log_errno(WLR_ERROR, "Failed to mmap anland dma-buf");
+			return false;
+		}
+		buffer->map_size = size;
+	}
+
+	*data = (uint8_t *)buffer->map + buffer->dmabuf.offset[0];
+	*format = buffer->dmabuf.format;
+	*stride = buffer->dmabuf.stride[0];
+	return true;
+}
+
+static void buffer_end_data_ptr_access(struct wlr_buffer *wlr_buffer) {
+	// The mapping stays until the buffer is destroyed.
+}
+
+static const struct wlr_buffer_impl buffer_impl = {
+	.destroy = buffer_destroy,
+	.get_dmabuf = buffer_get_dmabuf,
+	.begin_data_ptr_access = buffer_begin_data_ptr_access,
+	.end_data_ptr_access = buffer_end_data_ptr_access,
+};
+
+static void output_update_refresh(struct wlr_anland_output *output, int refresh);
+
+static struct wlr_anland_buffer *anland_buffer_create(struct wlr_anland_output *output,
+		int idx) {
+	struct wlr_anland_backend *backend = output->backend;
+
+	int fd = get_dmabuf_fd_at(backend->display, idx);
+	struct buf_info info;
+	if (fd < 0 || get_dmabuf_info_at(backend->display, idx, &info) < 0) {
+		return NULL;
+	}
+
+	struct wlr_anland_buffer *buffer = calloc(1, sizeof(*buffer));
+	if (buffer == NULL) {
+		return NULL;
+	}
+
+	buffer->dmabuf = (struct wlr_dmabuf_attributes){
+		.width = output->wlr_output.width,
+		.height = output->wlr_output.height,
+		.format = protocol_format_to_drm(info.format),
+		.modifier = info.modifier,
+		.n_planes = 1,
+		.offset = { info.offset },
+		.stride = { info.stride },
+		.fd = { -1 },
+	};
+
+	// Take our own reference: the producer library closes its copy of the fd
+	// when the consumer goes away, but a wlr_buffer may outlive that (the
+	// renderer caches an EGLImage against it).
+	buffer->dmabuf.fd[0] = fcntl(fd, F_DUPFD_CLOEXEC, 0);
+	if (buffer->dmabuf.fd[0] < 0) {
+		wlr_log_errno(WLR_ERROR, "Failed to dup anland dma-buf fd");
+		free(buffer);
+		return NULL;
+	}
+
+	wlr_buffer_init(&buffer->base, &buffer_impl,
+		output->wlr_output.width, output->wlr_output.height);
+
+	wlr_log(WLR_INFO, "anland: imported buf[%d] fd=%d %dx%d "
+		"stride=%u fmt=0x%x mod=0x%llx",
+		idx, fd, buffer->base.width, buffer->base.height,
+		info.stride, buffer->dmabuf.format,
+		(unsigned long long)info.modifier);
+
+	return buffer;
+}
+
+void wlr_anland_output_import_buffers(struct wlr_anland_output *output) {
+	struct wlr_anland_backend *backend = output->backend;
+
+	if (is_fallback(backend->display)) {
+		return;
+	}
+	int count = get_buf_count(backend->display);
+	if (count <= 0) {
+		return;
+	}
+
+	for (int i = 0; i < count && i < ANLAND_MAX_BUFS; i++) {
+		output->bufs[i] = anland_buffer_create(output, i);
+		if (output->bufs[i] == NULL) {
+			wlr_log(WLR_ERROR, "anland: failed to import dmabuf %d", i);
+			wlr_anland_output_release_buffers(output);
+			return;
+		}
+		/*
+		 * A freshly imported dmabuf has undefined contents, so every buffer
+		 * owes a full first paint — same as weston's renderbuffer import.
+		 */
+		pixman_region32_clear(&output->accum_damage[i]);
+		pixman_region32_union_rect(&output->accum_damage[i],
+			&output->accum_damage[i], 0, 0,
+			output->wlr_output.width, output->wlr_output.height);
+	}
+	output->buf_count = count;
+}
+
+void wlr_anland_output_release_buffers(struct wlr_anland_output *output) {
+	for (int i = 0; i < ANLAND_MAX_BUFS; i++) {
+		if (output->bufs[i] != NULL) {
+			wlr_buffer_drop(&output->bufs[i]->base);
+			output->bufs[i] = NULL;
+		}
+	}
+	output->buf_count = 0;
+}
+
+/*
+ * CPU fallback: copy the damaged rectangles from the compositor's frame into
+ * the consumer buffer via mmap(). Used when the GPU blit path is unavailable
+ * (external-only dma-buf, pixman renderer, ...). Both buffers are assumed to
+ * be 32bpp; channels are swizzled when the fourccs differ.
+ */
+static void copy_pixels_cpu(struct wlr_anland_buffer *dst,
+		struct wlr_buffer *src, const pixman_region32_t *damage) {
+	void *dst_data;
+	uint32_t dst_format;
+	size_t dst_stride;
+	if (!wlr_buffer_begin_data_ptr_access(&dst->base,
+			WLR_BUFFER_DATA_PTR_ACCESS_WRITE,
+			&dst_data, &dst_format, &dst_stride)) {
+		return;
+	}
+
+	/*
+	 * Read the source back through the renderer-independent path: mmap its
+	 * dma-buf if it has one, else ask for a data pointer.
+	 */
+	void *src_data = NULL;
+	uint32_t src_format = 0;
+	size_t src_stride = 0;
+	struct wlr_dmabuf_attributes src_dmabuf;
+	void *src_map = NULL;
+	size_t src_map_size = 0;
+
+	if (wlr_buffer_get_dmabuf(src, &src_dmabuf)) {
+		off_t size = (off_t)src_dmabuf.offset[0] +
+			(off_t)src_dmabuf.stride[0] * src->height;
+		src_map = mmap(NULL, size, PROT_READ, MAP_SHARED,
+			src_dmabuf.fd[0], 0);
+		if (src_map == MAP_FAILED) {
+			src_map = NULL;
+			wlr_buffer_end_data_ptr_access(&dst->base);
+			return;
+		}
+		src_map_size = size;
+		src_data = (uint8_t *)src_map + src_dmabuf.offset[0];
+		src_format = src_dmabuf.format;
+		src_stride = src_dmabuf.stride[0];
+	} else if (!wlr_buffer_begin_data_ptr_access(src,
+			WLR_BUFFER_DATA_PTR_ACCESS_READ,
+			&src_data, &src_format, &src_stride)) {
+		wlr_buffer_end_data_ptr_access(&dst->base);
+		return;
+	}
+
+	bool swizzle = src_format != dst_format;
+	int rects_len;
+	const pixman_box32_t *rects = pixman_region32_rectangles(damage, &rects_len);
+	for (int i = 0; i < rects_len; i++) {
+		const pixman_box32_t *r = &rects[i];
+		for (int y = r->y1; y < r->y2; y++) {
+			const uint8_t *s = (const uint8_t *)src_data +
+				(size_t)y * src_stride + (size_t)r->x1 * 4;
+			uint8_t *d = (uint8_t *)dst_data +
+				(size_t)y * dst_stride + (size_t)r->x1 * 4;
+			if (!swizzle) {
+				memcpy(d, s, (size_t)(r->x2 - r->x1) * 4);
+				continue;
+			}
+			// XRGB8888 is B,G,R,X in memory (LE) and ABGR8888 is
+			// R,G,B,A: swap R/B and force opaque alpha.
+			for (int x = r->x1; x < r->x2; x++) {
+				d[0] = s[2];
+				d[1] = s[1];
+				d[2] = s[0];
+				d[3] = 0xff;
+				s += 4;
+				d += 4;
+			}
+		}
+	}
+
+	if (src_map != NULL) {
+		munmap(src_map, src_map_size);
+	} else {
+		wlr_buffer_end_data_ptr_access(src);
+	}
+	wlr_buffer_end_data_ptr_access(&dst->base);
+}
+
+/*
+ * Copy `damage` from `src` into the consumer buffer `dst` using the
+ * compositor's renderer: import src as a texture and draw it into dst via
+ * wlr_renderer_begin_buffer_pass(). This is the GPU path (the same blit
+ * backend/drm/renderer.c uses for multi-GPU). Returns false if the renderer
+ * cannot do it, in which case the caller falls back to copy_pixels_cpu().
+ */
+static bool copy_pixels_gpu(struct wlr_anland_output *output,
+		struct wlr_anland_buffer *dst, struct wlr_buffer *src,
+		const pixman_region32_t *damage) {
+	struct wlr_renderer *renderer = output->wlr_output.renderer;
+	if (renderer == NULL) {
+		return false;
+	}
+
+	struct wlr_texture *tex = wlr_texture_from_buffer(renderer, src);
+	if (tex == NULL) {
+		return false;
+	}
+
+	struct wlr_render_pass *pass =
+		wlr_renderer_begin_buffer_pass(renderer, &dst->base, NULL);
+	if (pass == NULL) {
+		wlr_texture_destroy(tex);
+		return false;
+	}
+
+	wlr_render_pass_add_texture(pass, &(struct wlr_render_texture_options){
+		.texture = tex,
+		.clip = damage,
+		.blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+		.filter_mode = WLR_SCALE_FILTER_NEAREST,
+	});
+	if (!wlr_render_pass_submit(pass)) {
+		wlr_texture_destroy(tex);
+		return false;
+	}
+
+	wlr_texture_destroy(tex);
+	return true;
+}
+
+void wlr_anland_output_present(struct wlr_anland_output *output) {
+	struct wlr_anland_backend *backend = output->backend;
+
+	if (!backend->consumer_ready || is_fallback(backend->display)) {
+		return;
+	}
+	// One trigger_refresh() per buffer-ready from here on.
+	backend->consumer_ready = false;
+
+	if (output->buf_count == 0 || output->last_frame == NULL) {
+		/*
+		 * Nothing to draw with. Still ping the consumer so it does not fall
+		 * back after 5s; it will show whatever it already has.
+		 */
+		trigger_refresh(backend->display);
+		return;
+	}
+
+	int idx = get_selected_idx(backend->display);
+	if (idx < 0 || idx >= output->buf_count) {
+		idx = 0;
+	}
+	struct wlr_anland_buffer *dst = output->bufs[idx];
+	pixman_region32_t *damage = &output->accum_damage[idx];
+
+	/*
+	 * When the allocator handed the consumer's own buffer to the compositor
+	 * (see backend/anland/allocator.c), the committed frame already is the
+	 * buffer the consumer selected — copying it onto itself would be a
+	 * no-op at best and a GPU blit with overlapping src/dst at worst.
+	 */
+	if ((struct wlr_buffer *)dst == output->last_frame) {
+		pixman_region32_clear(damage);
+		trigger_refresh(backend->display);
+		return;
+	}
+
+	bool ok = copy_pixels_gpu(output, dst, output->last_frame, damage);
+	if (!ok) {
+		copy_pixels_cpu(dst, output->last_frame, damage);
+	}
+	pixman_region32_clear(damage);
+
+	trigger_refresh(backend->display);
+}
+
+static bool output_test(struct wlr_output *wlr_output,
+		const struct wlr_output_state *state) {
+	uint32_t unsupported = state->committed & ~SUPPORTED_OUTPUT_STATE;
+	if (unsupported != 0) {
+		wlr_log(WLR_DEBUG, "Unsupported output state fields: 0x%"PRIx32,
+			unsupported);
+		return false;
+	}
+
+	if (state->committed & WLR_OUTPUT_STATE_MODE) {
+		assert(state->mode_type == WLR_OUTPUT_STATE_MODE_CUSTOM);
+	}
+
+	if (state->committed & WLR_OUTPUT_STATE_LAYERS) {
+		for (size_t i = 0; i < state->layers_len; i++) {
+			// We have no plane to put layers on: force the scene to composite
+			// everything into the primary buffer.
+			state->layers[i].accepted = false;
+		}
+	}
+
+	return true;
+}
+
+static void output_update_refresh(struct wlr_anland_output *output, int refresh) {
+	if (refresh <= 0) {
+		refresh = ANLAND_DEFAULT_REFRESH;
+	}
+	output->wlr_output.refresh = refresh;
+	if (output->wlr_output.current_mode != NULL) {
+		output->wlr_output.current_mode->refresh = refresh;
+	}
+}
+
+static bool output_commit(struct wlr_output *wlr_output,
+		const struct wlr_output_state *state) {
+	struct wlr_anland_output *output = get_anland_output_from_output(wlr_output);
+
+	if (!output_test(wlr_output, state)) {
+		return false;
+	}
+
+	if (state->committed & WLR_OUTPUT_STATE_MODE) {
+		output_update_refresh(output, state->custom_mode.refresh);
+	}
+
+	bool pending_enabled = output_pending_enabled(wlr_output, state);
+
+	if (state->committed & WLR_OUTPUT_STATE_BUFFER) {
+		if (output->last_frame != state->buffer) {
+			wlr_buffer_unlock(output->last_frame);
+			output->last_frame = wlr_buffer_lock(state->buffer);
+		}
+
+		// Fold this frame's damage into every buffer's outstanding debt.
+		const pixman_region32_t *damage = NULL;
+		pixman_region32_t full;
+		if (state->committed & WLR_OUTPUT_STATE_DAMAGE) {
+			damage = &state->damage;
+		} else {
+			pixman_region32_init_rect(&full, 0, 0,
+				wlr_output->width, wlr_output->height);
+			damage = &full;
+		}
+		for (int i = 0; i < output->buf_count; i++) {
+			pixman_region32_union(&output->accum_damage[i],
+				&output->accum_damage[i], damage);
+		}
+		if (damage == &full) {
+			pixman_region32_fini(&full);
+		}
+
+		wlr_anland_output_present(output);
+	}
+
+	if (pending_enabled) {
+		struct wlr_output_event_present present_event = {
+			.commit_seq = wlr_output->commit_seq + 1,
+			.presented = true,
+		};
+		output_defer_present(wlr_output, present_event);
+	}
+
+	return true;
+}
+
+static void output_destroy(struct wlr_output *wlr_output) {
+	struct wlr_anland_output *output = get_anland_output_from_output(wlr_output);
+	struct wlr_anland_backend *backend = output->backend;
+
+	if (backend->output == output) {
+		backend->output = NULL;
+	}
+	wl_list_remove(&output->link);
+
+	wlr_anland_output_release_buffers(output);
+	wlr_buffer_unlock(output->last_frame);
+
+	for (int i = 0; i < ANLAND_MAX_BUFS; i++) {
+		pixman_region32_fini(&output->accum_damage[i]);
+	}
+
+	free(output);
+}
+
+static const struct wlr_output_impl output_impl = {
+	.destroy = output_destroy,
+	.test = output_test,
+	.commit = output_commit,
+};
+
+bool wlr_output_is_anland(struct wlr_output *wlr_output) {
+	return wlr_output->impl == &output_impl;
+}
+
+struct wlr_anland_output *get_anland_output_from_output(
+		struct wlr_output *wlr_output) {
+	assert(wlr_output_is_anland(wlr_output));
+	struct wlr_anland_output *output =
+		wl_container_of(wlr_output, output, wlr_output);
+	return output;
+}
+
+struct wlr_anland_output *wlr_anland_output_create(
+		struct wlr_anland_backend *backend) {
+	struct wlr_anland_output *output = calloc(1, sizeof(*output));
+	if (output == NULL) {
+		wlr_log(WLR_ERROR, "Failed to allocate wlr_anland_output");
+		return NULL;
+	}
+	output->backend = backend;
+
+	uint32_t sw, sh, sf, sr;
+	get_screen_info(backend->display, &sw, &sh, &sf, &sr);
+	if (sw == 0 || sh == 0) {
+		sw = 1280;
+		sh = 720;
+	}
+	int refresh = (int)(sr > 0 ? sr : ANLAND_DEFAULT_REFRESH);
+
+	struct wlr_output_state state;
+	wlr_output_state_init(&state);
+	wlr_output_state_set_custom_mode(&state, (int32_t)sw, (int32_t)sh, refresh);
+
+	struct wlr_output *wlr_output = &output->wlr_output;
+	wlr_output_init(wlr_output, &backend->backend, &output_impl,
+		backend->event_loop, &state);
+	wlr_output_state_finish(&state);
+
+	for (int i = 0; i < ANLAND_MAX_BUFS; i++) {
+		pixman_region32_init(&output->accum_damage[i]);
+	}
+
+	wlr_output_set_name(wlr_output, "ANLAND-1");
+	wlr_output_set_description(wlr_output, "Anland output");
+
+	wl_list_insert(&backend->outputs, &output->link);
+
+	/*
+	 * Import if the consumer is already up; otherwise consumer_connected()
+	 * does it later. new_output is deliberately NOT emitted here — see
+	 * anland.h: announced is held back until the pool exists, because sway
+	 * allocates its swapchain the moment it sees the output.
+	 */
+	wlr_anland_output_import_buffers(output);
+	if (output->buf_count > 0) {
+		output->announced = true;
+		wl_signal_emit_mutable(&backend->backend.events.new_output, wlr_output);
+	}
+
+	return output;
+}
