diff -ruN --ex wlroots-clean/backend/anland/allocator.c wlroots-0.18.2/backend/anland/allocator.c
--- wlroots-clean/backend/anland/allocator.c	1970-01-01 08:00:00
+++ wlroots-0.18.2/backend/anland/allocator.c	2026-09-23 14:04:38
@@ -0,0 +1,129 @@
+/*
+ * anland allocator — hand out the consumer's pre-allocated dmabufs.
+ *
+ * Why this exists: wlr_gles2 advertises only WLR_BUFFER_CAP_DMABUF
+ * (render/gles2/renderer.c: wlr_renderer_init(..., WLR_BUFFER_CAP_DMABUF)), so
+ * sway's wlr_allocator_autocreate must be given a dmabuf-backed allocator. The
+ * normal choices are:
+ *   - gbm: needs a real DRM node with PRIME fd export. Our /dev/dri/renderD128
+ *     is vkms — a virtual KMS node with no GPU behind it — so
+ *     wlr_gbm_allocator_create() fails with "PRIME export not supported".
+ *   - shm: needs WLR_BUFFER_CAP_SHM|DATA_PTR from the renderer, which gles2
+ *     does not advertise.
+ *   - drm dumb: needs drmIsMaster(), which a render node is not.
+ * All three dead-end on this device, hence "Failed to create allocator".
+ *
+ * The consumer (an Android app) already hands us a set of real GPU dmabufs over
+ * the anland protocol — the same ones weston and KWin render into. Handing
+ * those out as wlr_buffers is the only dmabuf source available here, and it is
+ * the direct path those two backends use.
+ */
+
+#include <stdlib.h>
+#include <unistd.h>
+
+#include <wlr/render/allocator.h>
+#include <wlr/render/drm_format_set.h>
+#include <wlr/util/log.h>
+#include <wlr/backend/anland.h>
+
+#include "anland.h"
+
+struct wlr_anland_allocator {
+	struct wlr_allocator base;
+	struct wlr_anland_backend *backend;
+	int robin;
+};
+
+static void allocator_destroy(struct wlr_allocator *wlr_allocator) {
+	struct wlr_anland_allocator *alloc =
+		wl_container_of(wlr_allocator, alloc, base);
+	free(alloc);
+}
+
+/*
+ * The consumer's set is a fixed geometry (see buf_info / the screen info the
+ * daemon reports). Requests for anything else have nowhere to come from, so
+ * they are refused rather than silently resized.
+ */
+static struct wlr_buffer *allocator_create_buffer(
+		struct wlr_allocator *wlr_allocator, int width, int height,
+		const struct wlr_drm_format *format) {
+	struct wlr_anland_allocator *alloc =
+		wl_container_of(wlr_allocator, alloc, base);
+	struct wlr_anland_output *output = alloc->backend->output;
+
+	if (output == NULL || output->buf_count == 0) {
+		wlr_log(WLR_DEBUG, "anland allocator: no imported consumer buffers yet");
+		return NULL;
+	}
+
+	struct wlr_anland_buffer *proto = output->bufs[0];
+	wlr_log(WLR_INFO, "anland allocator: request %dx%d fmt=0x%x "
+		"(pool is %dx%d fmt=0x%x)", width, height,
+		format ? format->format : 0,
+		proto->base.width, proto->base.height, proto->dmabuf.format);
+
+	if (width != proto->base.width || height != proto->base.height) {
+		wlr_log(WLR_ERROR, "anland allocator: refusing %dx%d (pool is %dx%d)",
+			width, height, proto->base.width, proto->base.height);
+		return NULL;
+	}
+	if (format != NULL && format->format != proto->dmabuf.format) {
+		/*
+		 * Do not refuse on a format mismatch: the pool entry reports its
+		 * real fourcc through get_dmabuf(), and the present path copies by
+		 * damage rather than by reinterpreting the source. Refusing here
+		 * just starves the swapchain.
+		 */
+		wlr_log(WLR_INFO, "anland allocator: format 0x%x != pool 0x%x, "
+			"handing the pool entry out anyway",
+			format->format, proto->dmabuf.format);
+	}
+
+	int idx = alloc->robin++ % output->buf_count;
+	struct wlr_anland_buffer *buffer = output->bufs[idx];
+
+	/*
+	 * Hand out the pool entry itself (a reference, not a copy). The
+	 * compositor's swapchain ends up with distinct pool entries whenever it
+	 * asks for more than one buffer, and wlr_anland_output_present() skips
+	 * the copy when the committed frame already is the consumer's selected
+	 * buffer.
+	 */
+	return wlr_buffer_lock(&buffer->base);
+}
+
+static const struct wlr_allocator_interface allocator_impl = {
+	.create_buffer = allocator_create_buffer,
+	.destroy = allocator_destroy,
+};
+
+struct wlr_allocator *wlr_anland_allocator_create_from_backend(
+		struct wlr_backend *wlr_backend) {
+	/*
+	 * Key off the live instance rather than the passed backend: sway hands
+	 * wlr_allocator_autocreate() its *multi* backend (anland + an extra
+	 * headless output), so wlr_backend_is_anland() is false there.
+	 */
+	struct wlr_anland_backend *backend = wlr_anland_current;
+	if (backend == NULL) {
+		return NULL;
+	}
+
+	struct wlr_anland_allocator *alloc = calloc(1, sizeof(*alloc));
+	if (alloc == NULL) {
+		return NULL;
+	}
+
+	/*
+	 * WLR_BUFFER_CAP_DMABUF is the capability gles2 looks for; advertising
+	 * it is what makes this allocator acceptable to the GLES2 renderer.
+	 */
+	wlr_allocator_init(&alloc->base, &allocator_impl, WLR_BUFFER_CAP_DMABUF);
+	alloc->backend = backend;
+	alloc->robin = 0;
+
+	wlr_log(WLR_INFO, "anland: created dmabuf allocator over the consumer pool");
+	return &alloc->base;
+}
diff -ruN --ex wlroots-clean/backend/anland/anland.h wlroots-0.18.2/backend/anland/anland.h
--- wlroots-clean/backend/anland/anland.h	1970-01-01 08:00:00
+++ wlroots-0.18.2/backend/anland/anland.h	2026-09-23 14:10:26
@@ -0,0 +1,153 @@
+#ifndef BACKEND_ANLAND_H
+#define BACKEND_ANLAND_H
+
+#include <pixman.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <wayland-server-core.h>
+
+#include <wlr/backend.h>
+#include <wlr/backend/interface.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_keyboard.h>
+#include <wlr/types/wlr_output.h>
+#include <wlr/types/wlr_pointer.h>
+#include <wlr/types/wlr_touch.h>
+
+/*
+ * Internal state for the anland backend: a producer for the Android display
+ * daemon. The consumer (an Android app) allocates a set of dmabufs and shows
+ * them with SurfaceFlinger; this backend renders the compositor's frames into
+ * whichever buffer the consumer has selected and hands it back over the
+ * refresh eventfd.
+ */
+
+struct display_ctx; // see display_producer.h
+struct InputEvent; // see protocol.h
+
+#define ANLAND_DEFAULT_SOCKET "/opt/anland/display_daemon.sock"
+#define ANLAND_DEFAULT_REFRESH (120 * 1000) // mHz
+#define ANLAND_RECONNECT_INTERVAL_MS 200
+#define ANLAND_MAX_BUFS 8 // matches MAX_BUFS in protocol.h
+
+struct wlr_anland_keyboard {
+	struct wlr_keyboard wlr_keyboard;
+	struct wlr_anland_backend *backend;
+};
+
+struct wlr_anland_pointer {
+	struct wlr_pointer wlr_pointer;
+	struct wlr_anland_backend *backend;
+};
+
+struct wlr_anland_touch {
+	struct wlr_touch wlr_touch;
+	struct wlr_anland_backend *backend;
+};
+
+struct wlr_anland_backend {
+	struct wlr_backend backend;
+	struct wl_event_loop *event_loop;
+	struct wl_listener event_loop_destroy;
+
+	struct display_ctx *display;
+	char *socket_path;
+
+	struct wl_event_source *reconnect_timer;
+	struct wl_event_source *buf_ready_source;
+	struct wl_event_source *input_source;
+
+	struct wl_list outputs; // wlr_anland_output.link
+	struct wlr_anland_output *output; // the single output, or NULL
+
+	struct wlr_anland_keyboard keyboard;
+	struct wlr_anland_pointer pointer;
+	struct wlr_anland_touch touch;
+
+	bool started;
+	// True between a buffer-ready notification and the trigger_refresh() that
+	// answers it. One trigger_refresh() per buffer-ready keeps the consumer's
+	// 5 second watchdog quiet and avoids handing it a half-updated buffer.
+	bool consumer_ready;
+};
+
+/*
+ * wlr_buffer wrapper around one consumer-allocated dma-buf. Wrapping the fd in
+ * a wlr_buffer is what makes it a legal destination for
+ * wlr_renderer_begin_buffer_pass() (the GLES2 renderer imports it as an
+ * EGLImage and attaches an FBO); get_dmabuf()/begin_data_ptr_access() also let
+ * the CPU fallback copy into it when the buffer is external-only.
+ */
+struct wlr_anland_buffer {
+	struct wlr_buffer base;
+	struct wlr_dmabuf_attributes dmabuf;
+	void *map;
+	size_t map_size;
+};
+
+struct wlr_anland_output {
+	struct wlr_output wlr_output;
+	struct wlr_anland_backend *backend;
+	struct wl_list link;
+
+	/*
+	 * True once new_output has been emitted. Delayed until the consumer's
+	 * dmabufs are imported: sway allocates its swapchain the moment it sees
+	 * the output, and the allocator cannot hand anything out before the
+	 * pool exists.
+	 */
+	bool announced;
+
+	struct wlr_anland_buffer *bufs[ANLAND_MAX_BUFS];
+	int buf_count;
+
+	/*
+	 * Per-buffer accumulated damage (buffer age). The consumer rotates the
+	 * selected index on its own, so every buffer must remember all changes
+	 * since it was last updated — the same scheme weston's anland backend
+	 * uses for its renderbuffers.
+	 */
+	pixman_region32_t accum_damage[ANLAND_MAX_BUFS];
+
+	// Most recent frame committed by the compositor (locked), used as the
+	// copy source. NULL before the first commit.
+	struct wlr_buffer *last_frame;
+};
+
+struct wlr_anland_backend *get_anland_backend_from_backend(
+	struct wlr_backend *backend);
+
+/*
+ * The live anland backend, set on create and cleared on destroy.
+ *
+ * wlr_allocator_autocreate() is handed the *multi* backend (anland plus
+ * sway's extra headless output), so wlr_backend_is_anland() is false there and
+ * cannot be used to recognise us. The allocator hook keys off this instead.
+ */
+extern struct wlr_anland_backend *wlr_anland_current;
+struct wlr_anland_output *get_anland_output_from_output(
+	struct wlr_output *wlr_output);
+
+struct wlr_anland_output *wlr_anland_output_create(
+	struct wlr_anland_backend *backend);
+// Import the consumer dmabuf set handed over by try_exit_fallback().
+void wlr_anland_output_import_buffers(struct wlr_anland_output *output);
+// Drop the imported set (consumer lost).
+void wlr_anland_output_release_buffers(struct wlr_anland_output *output);
+/*
+ * Copy the outstanding damage into the consumer's currently selected buffer
+ * and call trigger_refresh(). No-op when there is nothing to present with.
+ */
+void wlr_anland_output_present(struct wlr_anland_output *output);
+
+void wlr_anland_keyboard_init(struct wlr_anland_backend *backend);
+void wlr_anland_keyboard_finish(struct wlr_anland_backend *backend);
+void wlr_anland_pointer_init(struct wlr_anland_backend *backend);
+void wlr_anland_pointer_finish(struct wlr_anland_backend *backend);
+void wlr_anland_touch_init(struct wlr_anland_backend *backend);
+void wlr_anland_touch_finish(struct wlr_anland_backend *backend);
+void wlr_anland_handle_input_event(struct wlr_anland_backend *backend,
+	const struct InputEvent *ev);
+void wlr_anland_touch_cancel(struct wlr_anland_backend *backend);
+
+#endif
diff -ruN --ex wlroots-clean/backend/anland/backend.c wlroots-0.18.2/backend/anland/backend.c
--- wlroots-clean/backend/anland/backend.c	1970-01-01 08:00:00
+++ wlroots-0.18.2/backend/anland/backend.c	2026-09-23 14:10:58
@@ -0,0 +1,419 @@
+#include <assert.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/eventfd.h>
+#include <unistd.h>
+
+#include <wlr/backend/anland.h>
+#include <wlr/backend/interface.h>
+#include <wlr/interfaces/wlr_keyboard.h>
+#include <wlr/interfaces/wlr_output.h>
+#include <wlr/interfaces/wlr_pointer.h>
+#include <wlr/interfaces/wlr_touch.h>
+#include <wlr/types/wlr_input_device.h>
+#include <wlr/util/log.h>
+
+#include "anland.h"
+#include "display_producer.h"
+#include "protocol.h"
+#include "util/time.h"
+
+static const struct wlr_keyboard_impl keyboard_impl = {
+	.name = "anland-keyboard",
+};
+
+static const struct wlr_pointer_impl pointer_impl = {
+	.name = "anland-pointer",
+};
+
+static const struct wlr_touch_impl touch_impl = {
+	.name = "anland-touch",
+};
+
+struct wlr_anland_backend *get_anland_backend_from_backend(
+		struct wlr_backend *wlr_backend) {
+	assert(wlr_backend_is_anland(wlr_backend));
+	struct wlr_anland_backend *backend =
+		wl_container_of(wlr_backend, backend, backend);
+	return backend;
+}
+
+static void handle_fallback(void *data);
+
+/*
+ * buffer_ready eventfd handler: the consumer selected a buffer and wants a
+ * frame. Answer with exactly one trigger_refresh() (from the present below or
+ * from the compositor's commit) so the consumer's 5s watchdog stays quiet, and
+ * kick the compositor so damage gets rendered too.
+ */
+static int handle_buf_ready(int fd, uint32_t mask, void *data);
+
+static int handle_input(int fd, uint32_t mask, void *data);
+
+static void setup_consumer_sources(struct wlr_anland_backend *backend) {
+	struct wl_event_loop *loop = backend->event_loop;
+
+	if (backend->buf_ready_source == NULL) {
+		int fd = get_buffer_ready_fd(backend->display);
+		if (fd >= 0) {
+			backend->buf_ready_source =
+				wl_event_loop_add_fd(loop, fd, WL_EVENT_READABLE,
+					handle_buf_ready, backend);
+		}
+	}
+	if (backend->input_source == NULL) {
+		int fd = get_data_fd(backend->display);
+		if (fd >= 0) {
+			backend->input_source =
+				wl_event_loop_add_fd(loop, fd, WL_EVENT_READABLE,
+					handle_input, backend);
+		}
+	}
+}
+
+static void teardown_consumer_sources(struct wlr_anland_backend *backend) {
+	if (backend->buf_ready_source) {
+		wl_event_source_remove(backend->buf_ready_source);
+		backend->buf_ready_source = NULL;
+	}
+	if (backend->input_source) {
+		wl_event_source_remove(backend->input_source);
+		backend->input_source = NULL;
+	}
+}
+
+/*
+ * try_exit_fallback() just succeeded: the dmabufs are in hand and must be
+ * imported immediately. Wire up the fd sources and stop the reconnect poll.
+ */
+static void consumer_connected(struct wlr_anland_backend *backend) {
+	wlr_log(WLR_INFO, "anland: consumer connected");
+
+	setup_consumer_sources(backend);
+	backend->consumer_ready = false;
+
+	if (backend->output) {
+		wlr_anland_output_import_buffers(backend->output);
+		/*
+		 * First time the pool is actually in hand: only now is it safe to
+		 * tell the compositor about the output. Emitting earlier makes sway
+		 * allocate a swapchain against an empty pool and fail the output.
+		 */
+		if (!backend->output->announced && backend->output->buf_count > 0) {
+			backend->output->announced = true;
+			wl_signal_emit_mutable(&backend->backend.events.new_output,
+				&backend->output->wlr_output);
+		}
+	}
+
+	if (backend->reconnect_timer) {
+		wl_event_source_timer_update(backend->reconnect_timer, 0);
+	}
+}
+
+static int handle_reconnect_timer(void *data) {
+	struct wlr_anland_backend *backend = data;
+
+	if (!is_fallback(backend->display)) {
+		return 0;
+	}
+
+	if (try_exit_fallback(backend->display) == 0) {
+		consumer_connected(backend);
+		return 0;
+	}
+
+	// Still no consumer — keep polling.
+	wl_event_source_timer_update(backend->reconnect_timer,
+		ANLAND_RECONNECT_INTERVAL_MS);
+	return 0;
+}
+
+/*
+ * Consumer lost: the producer library has already released the consumer fds
+ * and dmabufs and re-entered fallback. Drop the event sources that pointed at
+ * the (now closed) fds, forget the imported buffers, and resume the reconnect
+ * loop.
+ */
+static void handle_fallback(void *data) {
+	struct wlr_anland_backend *backend = data;
+
+	wlr_log(WLR_INFO, "anland: consumer disconnected, entering fallback");
+
+	wlr_anland_touch_cancel(backend);
+	teardown_consumer_sources(backend);
+	backend->consumer_ready = false;
+
+	if (backend->output) {
+		wlr_anland_output_release_buffers(backend->output);
+	}
+
+	if (backend->reconnect_timer) {
+		wl_event_source_timer_update(backend->reconnect_timer,
+			ANLAND_RECONNECT_INTERVAL_MS);
+	}
+}
+
+static int handle_buf_ready(int fd, uint32_t mask, void *data) {
+	struct wlr_anland_backend *backend = data;
+	struct wlr_anland_output *output = backend->output;
+
+	eventfd_t val;
+	eventfd_read(fd, &val);
+
+	if (is_fallback(backend->display)) {
+		return 0;
+	}
+
+	if (output == NULL) {
+		return 0;
+	}
+
+	// The consumer selected a buffer and is waiting for it to be filled.
+	backend->consumer_ready = true;
+
+	/*
+	 * Ask the compositor for a fresh frame. wlr_output_send_frame() runs the
+	 * compositor's frame handler synchronously, so if there is any damage a
+	 * commit (and therefore a present + trigger_refresh()) happens before we
+	 * return.
+	 */
+	wlr_output_send_frame(&output->wlr_output);
+
+	if (backend->consumer_ready) {
+		/*
+		 * The compositor had nothing new to commit (idle desktop). Present
+		 * the last frame anyway — copying the outstanding damage into the
+		 * selected buffer and calling trigger_refresh() — so the consumer
+		 * is never left waiting.
+		 */
+		wlr_anland_output_present(output);
+	}
+
+	return 0;
+}
+
+static int handle_input(int fd, uint32_t mask, void *data) {
+	struct wlr_anland_backend *backend = data;
+	struct InputEvent ev;
+
+	if (is_fallback(backend->display)) {
+		return 0;
+	}
+
+	// poll_input_event() may drop us into fallback (and free the fds) mid-loop.
+	while (poll_input_event(backend->display, &ev, 0) > 0) {
+		wlr_anland_handle_input_event(backend, &ev);
+		if (is_fallback(backend->display)) {
+			break;
+		}
+	}
+
+	return 0;
+}
+
+static bool backend_start(struct wlr_backend *wlr_backend) {
+	struct wlr_anland_backend *backend =
+		get_anland_backend_from_backend(wlr_backend);
+
+	wlr_log(WLR_INFO, "Starting anland backend");
+
+	// Create the output first so consumer_connected() has somewhere to import
+	// the consumer's dmabufs into. It is not announced until that succeeds.
+	backend->output = wlr_anland_output_create(backend);
+	if (backend->output == NULL) {
+		return false;
+	}
+
+	// create() only did the daemon handshake; pick up the consumer if it is
+	// already up. On failure the reconnect timer keeps polling every 200ms.
+	if (try_exit_fallback(backend->display) == 0) {
+		consumer_connected(backend);
+	} else if (backend->reconnect_timer) {
+		wl_event_source_timer_update(backend->reconnect_timer,
+			ANLAND_RECONNECT_INTERVAL_MS);
+	}
+
+	wl_signal_emit_mutable(&backend->backend.events.new_input,
+		&backend->keyboard.wlr_keyboard.base);
+	wl_signal_emit_mutable(&backend->backend.events.new_input,
+		&backend->pointer.wlr_pointer.base);
+	wl_signal_emit_mutable(&backend->backend.events.new_input,
+		&backend->touch.wlr_touch.base);
+
+	backend->started = true;
+	return true;
+}
+
+static void backend_destroy(struct wlr_backend *wlr_backend) {
+	struct wlr_anland_backend *backend =
+		get_anland_backend_from_backend(wlr_backend);
+
+	if (wlr_anland_current == backend) {
+		wlr_anland_current = NULL;
+	}
+
+	wlr_backend_finish(wlr_backend);
+
+	if (backend->output) {
+		wlr_output_destroy(&backend->output->wlr_output);
+		backend->output = NULL;
+	}
+
+	wlr_anland_touch_finish(backend);
+	wlr_anland_pointer_finish(backend);
+	wlr_anland_keyboard_finish(backend);
+
+	teardown_consumer_sources(backend);
+	if (backend->reconnect_timer) {
+		wl_event_source_remove(backend->reconnect_timer);
+		backend->reconnect_timer = NULL;
+	}
+
+	if (backend->display) {
+		set_fallback_callback(backend->display, NULL, NULL);
+		disconnect(backend->display);
+		backend->display = NULL;
+	}
+
+	wl_list_remove(&backend->event_loop_destroy.link);
+	free(backend->socket_path);
+	free(backend);
+}
+
+static uint32_t get_buffer_caps(struct wlr_backend *wlr_backend) {
+	// The consumer's buffers are dma-bufs, but the compositor is free to
+	// render into anything: we copy the committed frame across either way.
+	return WLR_BUFFER_CAP_DATA_PTR | WLR_BUFFER_CAP_DMABUF | WLR_BUFFER_CAP_SHM;
+}
+
+static const struct wlr_backend_impl backend_impl = {
+	.start = backend_start,
+	.destroy = backend_destroy,
+	.get_buffer_caps = get_buffer_caps,
+};
+
+static void handle_event_loop_destroy(struct wl_listener *listener, void *data) {
+	struct wlr_anland_backend *backend =
+		wl_container_of(listener, backend, event_loop_destroy);
+	backend_destroy(&backend->backend);
+}
+
+bool wlr_backend_is_anland(struct wlr_backend *backend) {
+	return backend->impl == &backend_impl;
+}
+
+void wlr_anland_keyboard_init(struct wlr_anland_backend *backend) {
+	struct wlr_anland_keyboard *keyboard = &backend->keyboard;
+	keyboard->backend = backend;
+	wlr_keyboard_init(&keyboard->wlr_keyboard, &keyboard_impl,
+		keyboard_impl.name);
+}
+
+void wlr_anland_keyboard_finish(struct wlr_anland_backend *backend) {
+	wlr_keyboard_finish(&backend->keyboard.wlr_keyboard);
+}
+
+void wlr_anland_pointer_init(struct wlr_anland_backend *backend) {
+	struct wlr_anland_pointer *pointer = &backend->pointer;
+	pointer->backend = backend;
+	wlr_pointer_init(&pointer->wlr_pointer, &pointer_impl, pointer_impl.name);
+}
+
+void wlr_anland_pointer_finish(struct wlr_anland_backend *backend) {
+	wlr_pointer_finish(&backend->pointer.wlr_pointer);
+}
+
+void wlr_anland_touch_init(struct wlr_anland_backend *backend) {
+	struct wlr_anland_touch *touch = &backend->touch;
+	touch->backend = backend;
+	wlr_touch_init(&touch->wlr_touch, &touch_impl, touch_impl.name);
+}
+
+void wlr_anland_touch_finish(struct wlr_anland_backend *backend) {
+	wlr_touch_finish(&backend->touch.wlr_touch);
+}
+
+void wlr_anland_touch_cancel(struct wlr_anland_backend *backend) {
+	struct wlr_touch_cancel_event ev = {
+		.touch = &backend->touch.wlr_touch,
+		.time_msec = get_current_time_msec(),
+	};
+	wl_signal_emit_mutable(&backend->touch.wlr_touch.events.cancel, &ev);
+	wl_signal_emit_mutable(&backend->touch.wlr_touch.events.frame, NULL);
+}
+
+struct wlr_anland_backend *wlr_anland_current = NULL;
+
+struct wlr_backend *wlr_anland_backend_create(struct wl_event_loop *loop) {
+	wlr_log(WLR_INFO, "Creating anland backend");
+
+	const char *socket_path = getenv("ANLAND_SOCKET");
+	if (socket_path == NULL) {
+		socket_path = ANLAND_DEFAULT_SOCKET;
+	}
+
+	struct wlr_anland_backend *backend = calloc(1, sizeof(*backend));
+	if (backend == NULL) {
+		wlr_log(WLR_ERROR, "Failed to allocate wlr_anland_backend");
+		return NULL;
+	}
+
+	wlr_backend_init(&backend->backend, &backend_impl);
+	wlr_anland_current = backend;
+
+	backend->event_loop = loop;
+	wl_list_init(&backend->outputs);
+
+	backend->socket_path = strdup(socket_path);
+	if (backend->socket_path == NULL) {
+		wlr_log_errno(WLR_ERROR, "Allocation failed");
+		goto error;
+	}
+
+	if (connect_to_deamon(&backend->display, backend->socket_path) < 0) {
+		wlr_log(WLR_ERROR, "Failed to connect to anland daemon at %s",
+			backend->socket_path);
+		goto error;
+	}
+	set_fallback_callback(backend->display, handle_fallback, backend);
+
+	uint32_t sw, sh, sf, sr;
+	get_screen_info(backend->display, &sw, &sh, &sf, &sr);
+	wlr_log(WLR_INFO, "anland: daemon at %s, screen %ux%u, format %u, refresh %u mHz",
+		backend->socket_path, sw, sh, sf, sr);
+
+	wlr_anland_keyboard_init(backend);
+	wlr_anland_pointer_init(backend);
+	wlr_anland_touch_init(backend);
+
+	backend->reconnect_timer = wl_event_loop_add_timer(loop,
+		handle_reconnect_timer, backend);
+	if (backend->reconnect_timer == NULL) {
+		wlr_log(WLR_ERROR, "Failed to add reconnect timer");
+		goto error_display;
+	}
+	// create() only did the daemon handshake, so we start in fallback with no
+	// consumer fds or dmabufs. Arm the loop to pick them up via
+	// try_exit_fallback() once a consumer appears.
+	wl_event_source_timer_update(backend->reconnect_timer,
+		ANLAND_RECONNECT_INTERVAL_MS);
+
+	backend->event_loop_destroy.notify = handle_event_loop_destroy;
+	wl_event_loop_add_destroy_listener(loop, &backend->event_loop_destroy);
+
+	return &backend->backend;
+
+error_display:
+	if (backend->display) {
+		set_fallback_callback(backend->display, NULL, NULL);
+		disconnect(backend->display);
+	}
+	wlr_anland_touch_finish(backend);
+	wlr_anland_pointer_finish(backend);
+	wlr_anland_keyboard_finish(backend);
+error:
+	free(backend->socket_path);
+	free(backend);
+	return NULL;
+}
diff -ruN --ex wlroots-clean/backend/anland/display_producer.c wlroots-0.18.2/backend/anland/display_producer.c
--- wlroots-clean/backend/anland/display_producer.c	1970-01-01 08:00:00
+++ wlroots-0.18.2/backend/anland/display_producer.c	2026-09-23 12:04:27
@@ -0,0 +1,359 @@
+#define _GNU_SOURCE
+#include "display_producer.h"
+#include "socket_utils.h"
+
+#include <errno.h>
+#include <poll.h>
+#include <stdbool.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/eventfd.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <unistd.h>
+
+/* poll() timeout (ms) for the two reconnect handshake steps. Kept short so the
+ * caller's reconnect loop stays responsive when no consumer is present yet. */
+#define HANDSHAKE_TIMEOUT_MS 100
+
+struct display_ctx {
+    int      ctrl_fd;
+    int      data_fd;
+    int      buf_ready_efd;
+    int      refresh_done_efd;
+    int      shm_fd;
+    volatile uint32_t *shm_ptr;
+    uint32_t screen_w, screen_h;
+    uint32_t pixel_format;
+    uint32_t refresh;
+    bool     fallback;
+
+    int      dmabuf_fds[MAX_BUFS];
+    struct buf_info dmabuf_infos[MAX_BUFS];
+    int      buf_count;
+
+    void (*fallback_cb)(void *);
+    void  *fallback_userdata;
+};
+
+/*
+ * Release every consumer-side resource (dmabuf fds, the four picked-up fds and the
+ * shm mapping), leaving the context holding only the daemon ctrl_fd. Does NOT touch
+ * the fallback flag or fire the fallback callback — callers decide that. Idempotent.
+ */
+static void release_consumer_resources(display_ctx *ctx)
+{
+    for (int i = 0; i < ctx->buf_count; i++) {
+        if (ctx->dmabuf_fds[i] >= 0) {
+            close(ctx->dmabuf_fds[i]);
+            ctx->dmabuf_fds[i] = -1;
+        }
+    }
+    ctx->buf_count = 0;
+
+    if (ctx->data_fd >= 0)          { close(ctx->data_fd);          ctx->data_fd = -1; }
+    if (ctx->buf_ready_efd >= 0)    { close(ctx->buf_ready_efd);    ctx->buf_ready_efd = -1; }
+    if (ctx->refresh_done_efd >= 0) { close(ctx->refresh_done_efd); ctx->refresh_done_efd = -1; }
+    if (ctx->shm_ptr)               { munmap((void *)ctx->shm_ptr, sizeof(uint32_t)); ctx->shm_ptr = NULL; }
+    if (ctx->shm_fd >= 0)           { close(ctx->shm_fd);           ctx->shm_fd = -1; }
+}
+
+static void enter_fallback(display_ctx *ctx)
+{
+    if (ctx->fallback)
+        return;
+    ctx->fallback = true;
+
+    release_consumer_resources(ctx);
+
+    if (ctx->fallback_cb)
+        ctx->fallback_cb(ctx->fallback_userdata);
+}
+
+/*
+ * Ask the daemon for the consumer-side fds and map the shm index. Polls ctrl_fd
+ * with a short timeout so it returns promptly when no consumer is up yet. On
+ * success the four fds and shm_ptr are installed on ctx; the caller releases them
+ * via release_consumer_resources() on any later failure. Returns 0 / -1.
+ */
+static int pickup_fds(display_ctx *ctx)
+{
+    struct ctrl_msg hdr = { .type = CTRL_MSG_PICKUP_FDS, .size = 0 };
+    if (send_all(ctx->ctrl_fd, &hdr, sizeof(hdr)) < 0)
+        return -1;
+
+    struct pollfd pfd = { .fd = ctx->ctrl_fd, .events = POLLIN };
+    if (poll(&pfd, 1, HANDSHAKE_TIMEOUT_MS) <= 0)
+        return -1;
+
+    int fds[4];
+    int fd_count = 0;
+    struct ctrl_msg resp;
+    int n = recv_fds(ctx->ctrl_fd, &resp, sizeof(resp), fds, 4, &fd_count);
+    if (n <= 0 || resp.type != CTRL_MSG_FDS_READY || fd_count < 4) {
+        for (int i = 0; i < fd_count; i++)
+            close(fds[i]);
+        return -1;
+    }
+
+    ctx->buf_ready_efd    = fds[0];
+    ctx->refresh_done_efd = fds[1];
+    ctx->data_fd          = fds[2];
+    ctx->shm_fd           = fds[3];
+
+    ctx->shm_ptr = mmap(NULL, sizeof(uint32_t), PROT_READ, MAP_SHARED, ctx->shm_fd, 0);
+    if (ctx->shm_ptr == MAP_FAILED) {
+        ctx->shm_ptr = NULL;
+        return -1;
+    }
+    return 0;
+}
+
+/*
+ * Receive the dmabuf set the consumer pushes onto the data channel right after the
+ * fd handshake. Polls data_fd with a short timeout. On failure the caller releases
+ * the partially-acquired consumer resources. Returns 0 / -1.
+ */
+static int receive_dmabufs(display_ctx *ctx)
+{
+    if (ctx->buf_count > 0)
+        return 0;
+
+    struct pollfd pfd = { .fd = ctx->data_fd, .events = POLLIN | POLLHUP | POLLERR };
+    if (poll(&pfd, 1, HANDSHAKE_TIMEOUT_MS) <= 0)
+        return -1;
+    if (pfd.revents & (POLLHUP | POLLERR))
+        return -1;
+
+    struct data_msg dhdr;
+    int fds[MAX_BUFS];
+    int fd_count = 0;
+
+    int n = recv_fds(ctx->data_fd, &dhdr, sizeof(dhdr), fds, MAX_BUFS, &fd_count);
+    if (n < (int)sizeof(struct data_msg) || fd_count < 1)
+        return -1;
+
+    if (dhdr.type != DATA_MSG_BUFS_READY) {
+        for (int i = 0; i < fd_count; i++)
+            close(fds[i]);
+        return -1;
+    }
+
+    int count = dhdr.size / sizeof(struct buf_info);
+    if (count != fd_count || count > MAX_BUFS) {
+        for (int i = 0; i < fd_count; i++)
+            close(fds[i]);
+        return -1;
+    }
+
+    struct buf_info infos[MAX_BUFS];
+    if (recv_all(ctx->data_fd, infos, dhdr.size) < 0) {
+        for (int i = 0; i < fd_count; i++)
+            close(fds[i]);
+        return -1;
+    }
+
+    for (int i = 0; i < count; i++) {
+        ctx->dmabuf_fds[i] = fds[i];
+        ctx->dmabuf_infos[i] = infos[i];
+    }
+    ctx->buf_count = count;
+    return 0;
+}
+
+int connect_to_deamon(display_ctx **out, const char *socket_path)
+{
+    display_ctx *ctx = calloc(1, sizeof(*ctx));
+    if (!ctx)
+        return -1;
+
+    ctx->ctrl_fd = -1;
+    ctx->data_fd = -1;
+    ctx->buf_ready_efd = -1;
+    ctx->refresh_done_efd = -1;
+    ctx->shm_fd = -1;
+    ctx->shm_ptr = NULL;
+    ctx->fallback = true; // stay in fallback until try_exit_fallback() succeeds
+    for (int i = 0; i < MAX_BUFS; i++)
+        ctx->dmabuf_fds[i] = -1;
+
+    ctx->ctrl_fd = connect_unix(socket_path);
+    if (ctx->ctrl_fd < 0)
+        goto fail;
+
+    struct ctrl_msg hdr = { .type = CTRL_MSG_PRODUCER_HELLO, .size = 0 };
+    if (send_all(ctx->ctrl_fd, &hdr, sizeof(hdr)) < 0)
+        goto fail;
+
+    uint8_t buf[sizeof(struct ctrl_msg) + sizeof(struct screen_info)];
+    if (recv_all(ctx->ctrl_fd, buf, sizeof(buf)) < 0)
+        goto fail;
+
+    struct ctrl_msg resp;
+    memcpy(&resp, buf, sizeof(resp));
+    if (resp.type != CTRL_MSG_SCREEN_INFO || resp.size != sizeof(struct screen_info))
+        goto fail;
+
+    struct screen_info si;
+    memcpy(&si, buf + sizeof(struct ctrl_msg), sizeof(si));
+    ctx->screen_w = si.width;
+    ctx->screen_h = si.height;
+    ctx->pixel_format = si.format;
+    ctx->refresh = si.refresh;
+
+    // Daemon handshake only: screen info is in hand, but the consumer fds and
+    // dmabufs are deliberately left for try_exit_fallback() so the backend brings
+    // the consumer up through the single reconnect path. Stay in fallback.
+    *out = ctx;
+    return 0;
+
+fail:
+    if (ctx->ctrl_fd >= 0)
+        close(ctx->ctrl_fd);
+    free(ctx);
+    return -1;
+}
+
+void disconnect(display_ctx *ctx)
+{
+    if (!ctx)
+        return;
+    release_consumer_resources(ctx);
+    if (ctx->ctrl_fd >= 0)
+        close(ctx->ctrl_fd);
+    free(ctx);
+}
+
+int get_screen_info(display_ctx *ctx, uint32_t *width, uint32_t *height, uint32_t *format, uint32_t *refresh)
+{
+    *width  = ctx->screen_w;
+    *height = ctx->screen_h;
+    *format = ctx->pixel_format;
+    *refresh = ctx->refresh;
+    return 0;
+}
+
+int trigger_refresh(display_ctx *ctx)
+{
+    if (ctx->fallback)
+        return 0;
+
+    eventfd_t val = 1;
+    eventfd_write(ctx->refresh_done_efd, val);
+    return 0;
+}
+
+int poll_input_event(display_ctx *ctx, struct InputEvent *event, int timeout_ms)
+{
+    if (ctx->fallback)
+        return 0;
+
+    struct pollfd pfd = { .fd = ctx->data_fd, .events = POLLIN };
+    int ret = poll(&pfd, 1, timeout_ms);
+    if (ret <= 0)
+        return 0;
+
+    if (pfd.revents & (POLLHUP | POLLERR)) {
+        enter_fallback(ctx);
+        return -1;
+    }
+
+    uint8_t msg_buf[sizeof(struct data_msg) + sizeof(struct InputEvent)];
+    ssize_t n = recv(ctx->data_fd, msg_buf, sizeof(msg_buf), MSG_PEEK);
+    if (n < (ssize_t)sizeof(struct data_msg))
+        return 0;
+
+    struct data_msg hdr;
+    memcpy(&hdr, msg_buf, sizeof(hdr));
+    if (hdr.type != DATA_MSG_INPUT_EVENT)
+        return 0;
+
+    if (recv_all(ctx->data_fd, msg_buf, sizeof(struct data_msg) + sizeof(struct InputEvent)) < 0)
+        return -1;
+
+    memcpy(event, msg_buf + sizeof(struct data_msg), sizeof(*event));
+    return 1;
+}
+
+int set_fallback_callback(display_ctx *ctx, void (*on_fallback)(void *), void *userdata)
+{
+    ctx->fallback_cb = on_fallback;
+    ctx->fallback_userdata = userdata;
+    return 0;
+}
+
+bool is_fallback(display_ctx *ctx)
+{
+    return ctx->fallback;
+}
+
+int try_exit_fallback(display_ctx *ctx)
+{
+    if (!ctx->fallback)
+        return 0;
+
+    // Step 1: ask the daemon to hand over the consumer-side fds.
+    if (pickup_fds(ctx) < 0) {
+        release_consumer_resources(ctx);
+        return -1;
+    }
+
+    // Step 2: immediately pull the dmabuf set the consumer pushes right after the
+    // fd handshake. Only leave fallback once both fds and dmabufs are in hand, so
+    // the backend can import straight away.
+    if (receive_dmabufs(ctx) < 0) {
+        release_consumer_resources(ctx);
+        return -1;
+    }
+
+    ctx->fallback = false;
+    return 0;
+}
+
+int get_data_fd(display_ctx *ctx)
+{
+    return ctx->data_fd;
+}
+
+int get_buffer_ready_fd(display_ctx *ctx)
+{
+    return ctx->buf_ready_efd;
+}
+
+int get_buf_count(display_ctx *ctx)
+{
+    return ctx->buf_count;
+}
+
+int get_selected_idx(display_ctx *ctx)
+{
+    if (!ctx->shm_ptr)
+        return 0;
+    uint32_t idx = *ctx->shm_ptr;
+    return (idx < (uint32_t)ctx->buf_count) ? (int)idx : 0;
+}
+
+int get_dmabuf_fd(display_ctx *ctx)
+{
+    return get_dmabuf_fd_at(ctx, get_selected_idx(ctx));
+}
+
+int get_dmabuf_fd_at(display_ctx *ctx, int idx)
+{
+    if (idx < 0 || idx >= ctx->buf_count)
+        return -1;
+    return ctx->dmabuf_fds[idx];
+}
+
+int get_dmabuf_info(display_ctx *ctx, struct buf_info *info)
+{
+    return get_dmabuf_info_at(ctx, get_selected_idx(ctx), info);
+}
+
+int get_dmabuf_info_at(display_ctx *ctx, int idx, struct buf_info *info)
+{
+    if (idx < 0 || idx >= ctx->buf_count)
+        return -1;
+    *info = ctx->dmabuf_infos[idx];
+    return 0;
+}
diff -ruN --ex wlroots-clean/backend/anland/display_producer.h wlroots-0.18.2/backend/anland/display_producer.h
--- wlroots-clean/backend/anland/display_producer.h	1970-01-01 08:00:00
+++ wlroots-0.18.2/backend/anland/display_producer.h	2026-09-23 12:04:27
@@ -0,0 +1,59 @@
+#ifndef DISPLAY_PRODUCER_H
+#define DISPLAY_PRODUCER_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "protocol.h"
+
+typedef struct display_ctx display_ctx;
+
+/*
+ * Producer-side state machine
+ * ----------------------------
+ * connect_to_deamon() performs only the daemon handshake: it fetches the screen
+ * info and leaves the context in *fallback* (no consumer fds, no dmabufs). The
+ * backend then drives a reconnect loop that polls try_exit_fallback(); once that
+ * call succeeds the context owns the consumer fds and the dmabuf set, and
+ * is_fallback() returns false. Losing the consumer drops the context back to
+ * fallback (see set_fallback_callback) and the loop resumes.
+ */
+
+/* Connect to the daemon and fetch screen info only. Leaves the context in
+ * fallback: it does NOT pick up consumer fds or dmabufs. Returns 0 / -1. */
+int  connect_to_deamon(display_ctx **ctx, const char *socket_path);
+
+/* Tear down everything and disconnect from the daemon. */
+void disconnect(display_ctx *ctx);
+
+int  get_screen_info(display_ctx *ctx, uint32_t *width, uint32_t *height, uint32_t *format, uint32_t *refresh);
+
+/* Signal the consumer that the current frame is done. No-op in fallback. */
+int  trigger_refresh(display_ctx *ctx);
+
+/* Pull one pending input event. Returns 1 if an event was written, 0 if none was
+ * available, -1 on consumer loss. No-op (returns 0) in fallback. */
+int  poll_input_event(display_ctx *ctx, struct InputEvent *event, int timeout_ms);
+
+/* Register a callback invoked when the consumer is lost and the context drops
+ * back to fallback. */
+int  set_fallback_callback(display_ctx *ctx, void (*on_fallback)(void *), void *userdata);
+
+bool is_fallback(display_ctx *ctx);
+
+/* Attempt to leave fallback: pick up the consumer fds and immediately receive the
+ * dmabuf set (the consumer sends the dmabufs right after the fd handshake). Clears
+ * fallback only when BOTH the fds and the dmabufs are in hand, so on a 0 return the
+ * dmabufs are ready to import right away. Returns 0 on success, -1 if there is
+ * still no consumer (stays in fallback; safe to retry on the next tick). */
+int  try_exit_fallback(display_ctx *ctx);
+
+int  get_data_fd(display_ctx *ctx);
+int  get_buffer_ready_fd(display_ctx *ctx);
+int  get_buf_count(display_ctx *ctx);
+int  get_selected_idx(display_ctx *ctx);
+int  get_dmabuf_fd(display_ctx *ctx);
+int  get_dmabuf_fd_at(display_ctx *ctx, int idx);
+int  get_dmabuf_info(display_ctx *ctx, struct buf_info *info);
+int  get_dmabuf_info_at(display_ctx *ctx, int idx, struct buf_info *info);
+
+#endif
diff -ruN --ex wlroots-clean/backend/anland/input.c wlroots-0.18.2/backend/anland/input.c
--- wlroots-clean/backend/anland/input.c	1970-01-01 08:00:00
+++ wlroots-0.18.2/backend/anland/input.c	2026-09-23 12:30:20
@@ -0,0 +1,226 @@
+#include <linux/input-event-codes.h>
+#include <time.h>
+#include <wayland-server-protocol.h>
+
+#include <wlr/interfaces/wlr_keyboard.h>
+#include <wlr/types/wlr_pointer.h>
+#include <wlr/types/wlr_touch.h>
+#include <wlr/util/log.h>
+
+#include "anland.h"
+#include "display_producer.h"
+#include "protocol.h"
+#include "util/time.h"
+
+/*
+ * Conversion of the daemon's InputEvent stream into wlr events.
+ *
+ * Coordinate convention (shared with the weston and KWin producers): the
+ * event's x/y are in physical pixels of the screen from get_screen_info().
+ * wlr_pointer / wlr_touch want normalized 0..1 output coordinates, so divide
+ * by the screen size here. key.keycode is a Linux evdev keycode, same as
+ * wlr_keyboard_key_event.keycode.
+ */
+
+static void handle_pointer_motion(struct wlr_anland_backend *backend,
+		const struct InputEvent *ev) {
+	struct wlr_anland_output *output = backend->output;
+	double nx = 0, ny = 0;
+	if (output != NULL && output->wlr_output.width > 0 &&
+			output->wlr_output.height > 0) {
+		nx = (double)ev->pointer_motion.x / output->wlr_output.width;
+		ny = (double)ev->pointer_motion.y / output->wlr_output.height;
+	}
+	if (nx < 0) {
+		nx = 0;
+	} else if (nx > 1) {
+		nx = 1;
+	}
+	if (ny < 0) {
+		ny = 0;
+	} else if (ny > 1) {
+		ny = 1;
+	}
+
+	struct wlr_pointer_motion_absolute_event motion = {
+		.pointer = &backend->pointer.wlr_pointer,
+		.time_msec = get_current_time_msec(),
+		.x = nx,
+		.y = ny,
+	};
+	wl_signal_emit_mutable(&motion.pointer->events.motion_absolute, &motion);
+
+	if (ev->pointer_motion.dx != 0.0f || ev->pointer_motion.dy != 0.0f) {
+		struct wlr_pointer_motion_event rel = {
+			.pointer = &backend->pointer.wlr_pointer,
+			.time_msec = motion.time_msec,
+			.delta_x = ev->pointer_motion.dx,
+			.delta_y = ev->pointer_motion.dy,
+			.unaccel_dx = ev->pointer_motion.dx,
+			.unaccel_dy = ev->pointer_motion.dy,
+		};
+		wl_signal_emit_mutable(&rel.pointer->events.motion, &rel);
+	}
+
+	wl_signal_emit_mutable(&backend->pointer.wlr_pointer.events.frame,
+		&backend->pointer.wlr_pointer);
+}
+
+static void handle_pointer_button(struct wlr_anland_backend *backend,
+		const struct InputEvent *ev) {
+	struct wlr_pointer_button_event button = {
+		.pointer = &backend->pointer.wlr_pointer,
+		.time_msec = get_current_time_msec(),
+		.button = ev->pointer_button.button,
+		.state = ev->pointer_button.pressed ?
+			WL_POINTER_BUTTON_STATE_PRESSED :
+			WL_POINTER_BUTTON_STATE_RELEASED,
+	};
+	wl_signal_emit_mutable(&button.pointer->events.button, &button);
+	wl_signal_emit_mutable(&button.pointer->events.frame, button.pointer);
+}
+
+static void handle_pointer_axis(struct wlr_anland_backend *backend,
+		const struct InputEvent *ev) {
+	// Protocol axis: 0 = vertical scroll, 1 = horizontal (wayland order).
+	enum wl_pointer_axis orientation =
+		ev->pointer_axis.axis == 1 ?
+		WL_POINTER_AXIS_HORIZONTAL_SCROLL :
+		WL_POINTER_AXIS_VERTICAL_SCROLL;
+
+	struct wlr_pointer_axis_event axis = {
+		.pointer = &backend->pointer.wlr_pointer,
+		.time_msec = get_current_time_msec(),
+		.source = ev->pointer_axis.discrete != 0 ?
+			WL_POINTER_AXIS_SOURCE_WHEEL :
+			WL_POINTER_AXIS_SOURCE_CONTINUOUS,
+		.orientation = orientation,
+		.relative_direction = WL_POINTER_AXIS_RELATIVE_DIRECTION_IDENTICAL,
+		.delta = (double)ev->pointer_axis.value,
+		.delta_discrete = ev->pointer_axis.discrete *
+			WLR_POINTER_AXIS_DISCRETE_STEP,
+	};
+	wl_signal_emit_mutable(&axis.pointer->events.axis, &axis);
+	wl_signal_emit_mutable(&axis.pointer->events.frame, axis.pointer);
+}
+
+static void handle_key(struct wlr_anland_backend *backend,
+		const struct InputEvent *ev) {
+	struct wlr_keyboard_key_event key = {
+		.time_msec = get_current_time_msec(),
+		.keycode = ev->key.keycode,
+		.update_state = true,
+		.state = ev->key.action == INPUT_ACTION_DOWN ?
+			WL_KEYBOARD_KEY_STATE_PRESSED :
+			WL_KEYBOARD_KEY_STATE_RELEASED,
+	};
+	wlr_keyboard_notify_key(&backend->keyboard.wlr_keyboard, &key);
+}
+
+static void handle_touch(struct wlr_anland_backend *backend,
+		const struct InputEvent *ev) {
+	struct wlr_anland_output *output = backend->output;
+	double nx = 0, ny = 0;
+	if (output != NULL && output->wlr_output.width > 0 &&
+			output->wlr_output.height > 0) {
+		nx = (double)ev->touch.x / output->wlr_output.width;
+		ny = (double)ev->touch.y / output->wlr_output.height;
+	}
+	if (nx < 0) {
+		nx = 0;
+	} else if (nx > 1) {
+		nx = 1;
+	}
+	if (ny < 0) {
+		ny = 0;
+	} else if (ny > 1) {
+		ny = 1;
+	}
+
+	struct wlr_touch *touch = &backend->touch.wlr_touch;
+	uint32_t time_msec = get_current_time_msec();
+
+	switch (ev->touch.action) {
+	case INPUT_ACTION_DOWN: {
+		struct wlr_touch_down_event down = {
+			.touch = touch,
+			.time_msec = time_msec,
+			.touch_id = ev->touch.pointer_id,
+			.x = nx,
+			.y = ny,
+		};
+		wl_signal_emit_mutable(&touch->events.down, &down);
+		break;
+	}
+	case INPUT_ACTION_UP: {
+		struct wlr_touch_up_event up = {
+			.touch = touch,
+			.time_msec = time_msec,
+			.touch_id = ev->touch.pointer_id,
+		};
+		wl_signal_emit_mutable(&touch->events.up, &up);
+		break;
+	}
+	case INPUT_ACTION_MOVE: {
+		struct wlr_touch_motion_event motion = {
+			.touch = touch,
+			.time_msec = time_msec,
+			.touch_id = ev->touch.pointer_id,
+			.x = nx,
+			.y = ny,
+		};
+		wl_signal_emit_mutable(&touch->events.motion, &motion);
+		break;
+	}
+	default:
+		return;
+	}
+	wl_signal_emit_mutable(&touch->events.frame, NULL);
+}
+
+static void handle_display_refresh(struct wlr_anland_backend *backend,
+		const struct InputEvent *ev) {
+	// Not input: the consumer reports its live refresh rate in mHz so the
+	// output mode stays honest. Frame pacing itself is consumer-driven
+	// (buffer-ready), so this only updates the advertised mode.
+	uint32_t refresh_mhz = ev->display.refresh_mhz;
+	if (refresh_mhz == 0 || backend->output == NULL) {
+		return;
+	}
+
+	struct wlr_output *wlr_output = &backend->output->wlr_output;
+	if (wlr_output->current_mode != NULL) {
+		wlr_output->current_mode->refresh = (int32_t)refresh_mhz;
+	}
+	wlr_output->refresh = (int32_t)refresh_mhz;
+}
+
+void wlr_anland_handle_input_event(struct wlr_anland_backend *backend,
+		const struct InputEvent *ev) {
+	switch (ev->type) {
+	case INPUT_TYPE_POINTER_MOTION:
+		handle_pointer_motion(backend, ev);
+		break;
+	case INPUT_TYPE_POINTER_BUTTON:
+		handle_pointer_button(backend, ev);
+		break;
+	case INPUT_TYPE_POINTER_AXIS:
+		handle_pointer_axis(backend, ev);
+		break;
+	case INPUT_TYPE_KEY:
+		handle_key(backend, ev);
+		break;
+	case INPUT_TYPE_TOUCH:
+		handle_touch(backend, ev);
+		break;
+	case INPUT_TYPE_TOUCH_FRAME:
+		wl_signal_emit_mutable(&backend->touch.wlr_touch.events.frame, NULL);
+		break;
+	case INPUT_TYPE_DISPLAY_REFRESH:
+		handle_display_refresh(backend, ev);
+		break;
+	default:
+		wlr_log(WLR_DEBUG, "anland: unknown input event type %u", ev->type);
+		break;
+	}
+}
