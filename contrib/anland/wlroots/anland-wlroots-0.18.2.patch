diff -ruN --ex wlroots-clean/include/wlr/backend/anland.h wlroots-0.18.2/include/wlr/backend/anland.h
--- wlroots-clean/include/wlr/backend/anland.h	1970-01-01 08:00:00
+++ wlroots-0.18.2/include/wlr/backend/anland.h	2026-09-23 14:00:54
@@ -0,0 +1,52 @@
+/*
+ * This an unstable interface of wlroots. No guarantees are made regarding the
+ * future consistency of this API.
+ */
+#ifndef WLR_USE_UNSTABLE
+#error "Add -DWLR_USE_UNSTABLE to enable unstable wlroots features"
+#endif
+
+#ifndef WLR_BACKEND_ANLAND_H
+#define WLR_BACKEND_ANLAND_H
+
+#include <wlr/backend.h>
+#include <wlr/types/wlr_output.h>
+
+/**
+ * Creates an anland backend: a producer for the Android display daemon.
+ *
+ * The consumer (Android app) allocates a set of dmabufs and presents them via
+ * SurfaceFlinger; this backend renders the compositor's frames into the
+ * consumer's buffers and feeds input events from the daemon socket.
+ *
+ * The daemon socket is taken from the ANLAND_SOCKET environment variable
+ * (default /opt/anland/display_daemon.sock). The daemon must be reachable at
+ * creation time.
+ */
+struct wlr_backend *wlr_anland_backend_create(struct wl_event_loop *loop);
+
+bool wlr_backend_is_anland(struct wlr_backend *backend);
+bool wlr_output_is_anland(struct wlr_output *output);
+
+/**
+ * Creates an allocator that hands out the consumer's pre-allocated dmabufs.
+ *
+ * The GLES2 renderer only accepts WLR_BUFFER_CAP_DMABUF buffers, and on this
+ * device gbm / shm / drm-dumb allocators all dead-end (see backend/anland/
+ * allocator.c). This wraps the consumer's pool instead — the same buffers
+ * weston's and KWin's anland backends render into.
+ */
+struct wlr_allocator *wlr_anland_allocator_create_from_backend(
+	struct wlr_backend *backend);
+
+/**
+ * The live anland backend, or NULL. Set while an anland backend exists.
+ *
+ * Needed because wlr_allocator_autocreate() is handed the *multi* backend
+ * (anland plus the compositor's extra headless output), where
+ * wlr_backend_is_anland() is false.
+ */
+extern struct wlr_anland_backend *wlr_anland_current;
+struct wlr_anland_backend;
+
+#endif
