 struct wlr_allocator *wlr_allocator_autocreate(struct wlr_backend *backend,
 		struct wlr_renderer *renderer) {
 	uint32_t backend_caps = backend_get_buffer_caps(backend);
+
+	/*
+	 * The anland backend presents into the Android consumer's pre-allocated
+	 * dmabufs and has no PRIME-exportable DRM node, so the gbm/shm/drm-dumb
+	 * candidates below cannot serve the GLES2 renderer (which only accepts
